@model LAB09.Models.ProductoModel

@{
    ViewBag.Title = "Eliminar producto";
}

<h2 class="mt-4 mb-3">Eliminar producto</h2>

<div class="alert alert-danger" style="max-width: 640px;">
    <strong>¿Está seguro de que desea eliminar este producto?</strong> Esta acción no se puede deshacer.
</div>

<div class="card border-danger shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Id)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descripcion)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Precio)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Precio)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Stock)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Stock) unidades</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="mt-3">
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}
