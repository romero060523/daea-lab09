@model LAB09.Models.ProductoModel

@{
    ViewBag.Title = "Registrar producto";
}

<h2 class="mt-4 mb-3">Registrar producto</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div style="max-width: 640px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(model => model.Nombre, new { @class = "form-label" })
            @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej. Laptop HP 15" } })
            @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.Descripcion, new { @class = "form-label" })
            @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "form-control", rows = 3 } })
            @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                @Html.LabelFor(model => model.Precio, "Precio (S/)", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Precio, new { @class = "form-control", type = "number", step = "0.01", min = "0.01" })
                @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-6 mb-3">
                @Html.LabelFor(model => model.Stock, new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Stock, new { @class = "form-control", type = "number", step = "1", min = "0" })
                @Html.ValidationMessageFor(model => model.Stock, "", new { @class = "text-danger" })
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
